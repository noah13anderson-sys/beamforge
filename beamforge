#!/usr/bin/env bash
# Start BeamForge in its own app window (GTK + WebKit). Falls back to a browser window
# only if the WebKit runtime isn't installed (Arch: pacman -S webkit2gtk-4.1 python-gobject).
cd "$(dirname "$(readlink -f "$0")")" || exit 1
if [ -z "$BEAMFORGE_BROWSER" ] && python3 -c "import gi; gi.require_version('WebKit2','4.1')" 2>/dev/null; then
  exec python3 desktop/beamforge-app.py "$@"
fi
PORT="${BEAMFORGE_PORT:-8787}"
URL="http://localhost:$PORT"
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/beamforge.log"
mkdir -p "$(dirname "$LOG")"

running() { curl -s -o /dev/null -m 1 "$URL/" ; }

if ! running; then
  BEAMFORGE_AUTO_EXIT=1 nohup node server.js >"$LOG" 2>&1 &
  for _ in $(seq 1 40); do running && break; sleep 0.1; done
  if ! running; then
    notify-send -i beamforge "BeamForge" "Could not start the server. See $LOG" 2>/dev/null
    echo "BeamForge failed to start, see $LOG" >&2
    exit 1
  fi
fi

if command -v firefox >/dev/null; then
  firefox --new-window "$URL" >/dev/null 2>&1 &
else
  xdg-open "$URL" >/dev/null 2>&1 &
fi
